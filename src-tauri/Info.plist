<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hitch is a menu-bar app from its first moment. Without this macOS starts it as a
	     Dock app and Hitch switches over a moment later; that switch dismissed the welcome
	     window, so a first launch showed nothing at all. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Shown by macOS the first time Hitch restarts Claude. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Hitch quits and reopens Claude when you click Restart Claude, so Claude picks up its new settings.</string>
</dict>
</plist>
