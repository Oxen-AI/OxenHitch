<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hitch asks Claude to quit (a normal quit, sent as an Apple event) when the user
	     clicks Restart Claude. A signed app needs this to be allowed to ask. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
