{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hitch",
  "version": "0.1.4",
  "identifier": "ai.oxen.hitch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hitch",
        "width": 340,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "copyright": "Oxen.ai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
